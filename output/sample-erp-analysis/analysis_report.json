      {
        "name": "CalculateDiscount 決策邏輯",
        "rule_type": "decision",
        "description": "",
        "source_function": "CalculateDiscount",
        "source_file": "Customer.cls",
        "decision_table": [
          {
            "condition": "m_MemberLevel = \"VIP\" And m_TotalPurchase > 10000",
            "result": "CalculateDiscount = 0.15  ' VIP 且消費超過 10000，享 15% 折扣"
          },
          {
            "condition": "m_MemberLevel = \"VIP\"",
            "result": "CalculateDiscount = 0.1   ' VIP 會員享 10% 折扣"
          },
          {
            "condition": "m_TotalPurchase > 5000",
            "result": "CalculateDiscount = 0.05  ' 消費超過 5000 享 5% 折扣"
          },
          {
            "condition": "其他情況",
            "result": "CalculateDiscount = 0     ' 無折扣"
          }
        ],
        "formula": "",
        "input_variables": [],
        "output_variable": "",
        "pseudocode": "IF m_MemberLevel = \"VIP\" And m_TotalPurchase > 10000 THEN\n    CalculateDiscount = 0.15  ' VIP 且消費超過 10000，享 15% 折扣\nELSE IF m_MemberLevel = \"VIP\" THEN\n    CalculateDiscount = 0.1   ' VIP 會員享 10% 折扣\nELSE IF m_TotalPurchase > 5000 THEN\n    CalculateDiscount = 0.05  ' 消費超過 5000 享 5% 折扣\nELSE\n    CalculateDiscount = 0     ' 無折扣\nEND IF"
      },
      {
        "name": "UpgradeMemberLevel 狀態邏輯 (m_TotalPurchase)",
        "rule_type": "decision",
        "description": "",
        "source_function": "UpgradeMemberLevel",
        "source_file": "Customer.cls",
        "decision_table": [
          {
            "condition": "m_TotalPurchase = Is >= 50000",
            "result": "m_MemberLevel = \"PLATINUM\""
          },
          {
            "condition": "m_TotalPurchase = Is >= 20000",
            "result": "m_MemberLevel = \"VIP\""
          },
          {
            "condition": "m_TotalPurchase = Is >= 5000",
            "result": "m_MemberLevel = \"GOLD\""
          },
          {
            "condition": "m_TotalPurchase = Else",
            "result": "m_MemberLevel = \"STANDARD\""
          }
        ],
        "formula": "",
        "input_variables": [],
        "output_variable": "",
        "pseudocode": "IF m_TotalPurchase = Is >= 50000 THEN\n    m_MemberLevel = \"PLATINUM\"\nELSE IF m_TotalPurchase = Is >= 20000 THEN\n    m_MemberLevel = \"VIP\"\nELSE IF m_TotalPurchase = Is >= 5000 THEN\n    m_MemberLevel = \"GOLD\"\nELSE IF m_TotalPurchase = Else THEN\n    m_MemberLevel = \"STANDARD\"\nEND IF"
      },
